# Lavdesign Tilinpäätös — AI-dokumenttiparsinta (tiliotteet)
# Kopioi → .env.local ja täytä vähintään yksi avain.

# Suositus 1: OpenAI
OPENAI_API_KEY=
# Valinnainen malli (oletus: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Suositus 2: Google Gemini (jompikumpi riittää)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# Valinnainen malli (oletus: gemini-2.5-flash)
# GOOGLE_MODEL=gemini-2.5-flash
